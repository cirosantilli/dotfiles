{
    "[python]": {
        "editor.formatOnType": true
    },
    "[shellscript]": {
        "editor.tabSize": 2
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[javascriptreact]": {
        "editor.tabSize": 2
    },
    "[typescript]": {
        "editor.tabSize": 2
    },
    "[scss]": {
        "editor.tabSize": 2
    },
    "[typescriptreact]": {
        "editor.tabSize": 2
    },
    "editor.detectIndentation": false,
    "editor.minimap.enabled": false,
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
        "comments": true,
        "strings": true
    },
    "editor.renderWhitespace": "trailing",
    "editor.wordWrap": "off",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": true,
    "keyboard.dispatch": "keyCode",
    "merge-conflict.codeLens.enabled": false,
    "merge-conflict.decorators.enabled": false,
    "mesonbuild.configureOnOpen": false,
    "python.analysis.extraPaths": [],
    "python.autoComplete.extraPaths": [],
    "search.useParentIgnoreFiles": true,
    "security.workspace.trust.untrustedFiles": "open",
    "terminal.integrated.allowChords": false,
    "terminal.integrated.customGlyphs": false,
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "terminal.integrated.rightClickBehavior": "nothing",
    "vim.commandLineModeKeyBindings": [],
    "vim.easymotion": true,
    "vim.handleKeys": {
        "<C-E>": false,
        "<C-f>": false,
        "<C-k>": false,
        "<C-p>": false,
        "<C-t>": false,
        "<C-w>": false,
        "<C-x>": false,
        "<tab>": false
    },
    "vim.leader": ",",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            // Paste normal mode
            // https://stackoverflow.com/questions/58306002/vs-code-vim-extension-copy-and-paste
            "before": ["<C-a>"], 
            "after":  ["\"", "+", "P"]
        },
        {
            "after": [
                "5",
                "j"
            ],
            "before": [
                "J"
            ]
        },
        {
            "after": [
                "5",
                "k"
            ],
            "before": [
                "K"
            ]
        },
        {
            "after": [
                "g",
                "j"
            ],
            "before": [
                "j"
            ]
        },
        {
            "after": [
                "g",
                "k"
            ],
            "before": [
                "k"
            ]
        },
        {
            "after": [
                "^"
            ],
            "before": [
                "H"
            ]
        },
        {
            "after": [],
            "before": [
                "u"
            ],
            "commands": [
                {
                    "command": "undo"
                }
            ]
        },
        {
            "after": [],
            "before": [
                "<C-r>"
            ],
            "commands": [
                {
                    "command": "redo"
                }
            ]
        },
        {
            "after": [
                "$"
            ],
            "before": [
                "L"
            ]
        },
        {
            "after": [
                "v"
            ],
            "before": [
                "V"
            ]
        },
        {
            "after": [
                "V"
            ],
            "before": [
                "v"
            ]
        },
        {
            // Copy to clipboard.
            "after": [
                "\"",
                "+",
                "y"
            ],
            "before": [
                "Y"
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "after": [],
            "before": [
                ",",
                "e"
            ],
            "commands": [
                {
                    "command": "workbench.action.files.openFile"
                }
            ]
        },
        {
            "after": [
                "5",
                "j"
            ],
            "before": [
                "J"
            ]
        },
        {
            "after": [
                "5",
                "k"
            ],
            "before": [
                "K"
            ]
        },
        {
            "after": [
                "g",
                "j"
            ],
            "before": [
                "j"
            ]
        },
        {
            "after": [
                "g",
                "k"
            ],
            "before": [
                "k"
            ]
        },
        {
            "after": [
                "^"
            ],
            "before": [
                "H"
            ]
        },
        {
            "after": [],
            "before": [
                "u"
            ],
            "commands": [
                {
                    "command": "undo"
                }
            ]
        },
        {
            // Make C-v paste rather than to into block visual mode.
            "after": [],
            "before": [
                "<C-v>"
            ],
            "commands": [
                {
                    "command": "editor.action.clipboardPasteAction"
                }
            ]
        },
        {
            "after": [],
            "before": [
                "<C-r>"
            ],
            "commands": [
                {
                    "command": "redo"
                }
            ]
        },
        {
            "after": [
                "$"
            ],
            "before": [
                "L"
            ]
        },
        {
            // Replace text under cursor. The initial replacement is set to the original text.
            "after": [
                "\"",
                "z",
                "y",
                ":",
                "%",
                "s",
                "/",
                "<c-r>",
                "z",
                "/",
                "<c-r>",
                "z",
                "/",
                "g",
                "<left>",
                "<left>"
            ],
            "before": [
                "s"
            ]
        },
        {
            // Copy to clipboard.
            "after": [
                "\"",
                "+",
                "y"
            ],
            "before": [
                "Y"
            ]
        }
    ],
    "workbench.colorCustomizations": {
        // https://stackoverflow.com/questions/42780975/visual-studio-code-status-bar-color
        "statusBar.background": "#303030",
        "statusBar.debuggingBackground": "#511f1f",
        "statusBar.noFolderBackground": "#222225"
    },
    "workbench.colorTheme": "Default Dark+",
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "settingsSync.keybindingsPerPlatform": false,
    "git.openRepositoryInParentFolders": "never",
    "cmake.configureOnOpen": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "window.commandCenter": false,
    "window.restoreWindows": "all",
    "workbench.layoutControl.enabled": false,
    "window.menuBarVisibility": "toggle",
    "explorer.confirmDelete": false,
    "clangd.detectExtensionConflicts": false,
    "cmake.showOptionsMovedNotification": false,
