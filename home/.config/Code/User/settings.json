{
    "editor.minimap.enabled": false,
    "keyboard.dispatch": "keyCode",
    "workbench.colorTheme": "Default Dark+",
    "vim.handleKeys": {
        "<C-k>": false,
        "<C-E>": false,
        "<C-f>": false,
        "<C-t>": false,
        "<C-w>": false,
        "<C-x>": false,
        "<tab>": false
    },
    "vim.normalModeKeyBindings": [
        {
            "before": [",", "e"],
            "after": [":", "e", " "]
        },
        {
            "before": ["J"],
            "after": ["5", "j"]
        },
        {
            "before": ["K"],
            "after": ["5", "k"]
        },
        {
            "before": ["H"],
            "after": ["^"]
        },
        {
            "before": ["L"],
            "after": ["$"]
        }
    ],
    "files.insertFinalNewline": true,
    "mesonbuild.configureOnOpen": false,
    "files.autoSave": "onFocusChange",
    "search.useParentIgnoreFiles": true,
    "editor.wordWrap": "off",
    "[shellscript]": {
        "editor.tabSize": 2
    },
    "vim.easymotion": true,
    "vim.leader": ",",
    "search.exclude": {
        "smartnic_cmodel/build/**": true,
        "smartnic_fw/build/**": true,
        "smartnic-snapper/build/**": true
    },

    // https://github.com/microsoft/vscode/issues/108590
    // https://stackoverflow.com/questions/65147934/how-to-fix-vs-code-integrated-terminal-choppy-and-laggy-on-macos-big-sur
    "terminal.integrated.allowChords": false,
    "terminal.integrated.customGlyphs": false,
    "terminal.integrated.drawBoldTextInBrightColors": false,
    "terminal.integrated.experimentalLinkProvider": false,
    "terminal.integrated.rendererType": "auto",
    // This seems to sepeed up keys showing up slowly after typing.
    // But not the slowness after hitting enter after typing up a command.
    "terminal.integrated.gpuAcceleration": "off",
    // https://github.com/microsoft/vscode/issues/37888#issuecomment-343082454
    "terminal.integrated.fontSize": 13,

    "workbench.startupEditor": "none",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x86",
    "C_Cpp.intelliSenseEngine": "Tag Parser",
    "editor.renderWhitespace": "trailing",
    "explorer.confirmDelete": false,
    "window.menuBarVisibility": "toggle",
    "workbench.sideBar.location": "right",
    "python.defaultInterpreterPath": "python3",
    "[python]": {
        "editor.formatOnType": true
    },
    "gitlens.codeLens.authors.enabled": false,
    "remote.SSH.remotePlatform": {
        "lockhart5": "linux",
        "xcbciros41x": "linux",
        "xcbl-rtl01": "linux"
    },
    "editor.accessibilitySupport": "off",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "terminal.integrated.enableBell": true,
    "audioCues.volume": 100,
    "terminal.integrated.bellDuration": 5000,
}